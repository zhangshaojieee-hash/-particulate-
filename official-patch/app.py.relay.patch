+def _positive_int_env(name: str, default: int) -> int:
+    value = os.environ.get(name, "").strip()
+    if not value:
+        return default
+    try:
+        parsed = int(value)
+    except ValueError:
+        print(f"Ignoring invalid {name}={value!r}; using {default}")
+        return default
+    if parsed <= 0:
+        print(f"Ignoring non-positive {name}={parsed}; using {default}")
+        return default
+    return parsed
+
